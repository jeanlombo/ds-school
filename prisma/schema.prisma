generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Ecole {
  id           Int                @id @default(autoincrement())
  nom          String
  code         String             @unique
  typeEtablissement String         @default("MIXTE") @map("type_etablissement")
  terminologieApprenant String     @default("AUTOMATIQUE") @map("terminologie_apprenant")
  slogan       String?
  logo         String?
  adresse      String?
  ville        String?
  pays         String?            @default("République démocratique du Congo")
  telephone    String?
  email        String?
  siteWeb      String?            @map("site_web")
  devise       String             @default("CDF")
  directeur    String?
  boitePostale String?            @map("boite_postale")
  statut       String             @default("active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  annees       AnneeScolaire[]
  sections     Section[]
  classes      Classe[]
  eleves       Eleve[]
  responsables ResponsableEleve[]
  enseignants  Enseignant[]

  @@map("ecoles")
}

model Utilisateur {
  id         Int       @id @default(autoincrement())
  nom        String
  email      String    @unique
  motDePasse String    @map("mot_de_passe")
  role       String    @default("administrateur")
  statut     String    @default("actif")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  sessions   Session[]

  @@map("utilisateurs")
}

model Session {
  id            Int         @id @default(autoincrement())
  jetonHash     String      @unique @map("jeton_hash") @db.VarChar(64)
  utilisateurId Int         @map("utilisateur_id")
  expireAt      DateTime    @map("expire_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([expireAt])
  @@map("sessions")
}

model AnneeScolaire {
  id           Int           @id @default(autoincrement())
  ecoleId      Int           @map("ecole_id")
  libelle      String
  dateDebut    DateTime      @map("date_debut") @db.Date
  dateFin      DateTime      @map("date_fin") @db.Date
  active       Boolean       @default(false)
  statut       String        @default("ouverte")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  ecole        Ecole         @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  inscriptions Inscription[]

  @@unique([ecoleId, libelle])
  @@index([ecoleId, active])
  @@map("annees_scolaires")
}

model Section {
  id          Int      @id @default(autoincrement())
  ecoleId     Int      @map("ecole_id")
  nom         String
  code        String
  description String?
  typeSection String   @default("AUTRE") @map("type_section")
  statut      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  ecole       Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  classes     Classe[]

  @@unique([ecoleId, code])
  @@index([ecoleId, statut])
  @@map("sections")
}

model Classe {
  id                     Int                     @id @default(autoincrement())
  ecoleId                Int                     @map("ecole_id")
  sectionId              Int                     @map("section_id")
  nom                    String
  code                   String
  niveau                 String?
  capacite               Int                     @default(40)
  titulaire              String?
  local                  String?
  statut                 String                  @default("active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  ecole                  Ecole                   @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  section                Section                 @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  inscriptions           Inscription[]
  affectationsEnseignant AffectationEnseignant[]

  @@unique([ecoleId, code])
  @@index([sectionId])
  @@index([ecoleId, statut])
  @@map("classes")
}

model Eleve {
  id               Int                @id @default(autoincrement())
  ecoleId          Int                @map("ecole_id")
  matricule        String
  nom              String
  postnom          String?
  prenom           String
  sexe             String             @db.VarChar(1)
  dateNaissance    DateTime           @map("date_naissance") @db.Date
  lieuNaissance    String?            @map("lieu_naissance")
  nationalite      String?            @default("Congolaise")
  adresse          String?
  photo            String?
  numeroPermanent  String?            @map("numero_permanent")
  groupeSanguin    String?            @map("groupe_sanguin")
  allergies        String?            @db.Text
  handicap         String?            @db.Text
  contactUrgence   String?            @map("contact_urgence")
  telephoneUrgence String?            @map("telephone_urgence")
  statut           String             @default("actif")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  ecole            Ecole              @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  inscriptions     Inscription[]
  responsables     ResponsableEleve[]
  documents        DocumentEleve[]
  observations     ObservationEleve[]
  historiques      HistoriqueEleve[]

  @@unique([ecoleId, matricule])
  @@index([ecoleId, statut])
  @@index([nom, prenom])
  @@map("eleves")
}

model ResponsableEleve {
  id         Int      @id @default(autoincrement())
  ecoleId    Int      @map("ecole_id")
  eleveId    Int      @map("eleve_id")
  type       String
  nom        String
  telephone  String?
  email      String?
  profession String?
  adresse    String?
  principal  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  ecole      Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  eleve      Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@index([eleveId])
  @@index([ecoleId])
  @@map("responsables_eleves")
}

model Inscription {
  id              Int           @id @default(autoincrement())
  eleveId         Int           @map("eleve_id")
  classeId        Int           @map("classe_id")
  anneeScolaireId Int           @map("annee_scolaire_id")
  dateInscription DateTime      @default(now()) @map("date_inscription") @db.Date
  typeAdmission   String        @default("nouveau") @map("type_admission")
  ancienneEcole   String?       @map("ancienne_ecole")
  statut          String        @default("inscrit")
  createdAt       DateTime      @default(now()) @map("created_at")
  eleve           Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classe          Classe        @relation(fields: [classeId], references: [id], onDelete: Restrict)
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)

  @@unique([eleveId, anneeScolaireId])
  @@index([classeId, anneeScolaireId])
  @@map("inscriptions")
}

model DocumentEleve {
  id         Int      @id @default(autoincrement())
  eleveId    Int      @map("eleve_id")
  type       String
  nomFichier String   @map("nom_fichier")
  chemin     String
  createdAt  DateTime @default(now()) @map("created_at")
  eleve      Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@index([eleveId])
  @@map("documents_eleves")
}

model ObservationEleve {
  id        Int      @id @default(autoincrement())
  eleveId   Int      @map("eleve_id")
  contenu   String   @db.Text
  auteur    String?
  createdAt DateTime @default(now()) @map("created_at")
  eleve     Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@index([eleveId])
  @@map("observations_eleves")
}

model HistoriqueEleve {
  id        Int      @id @default(autoincrement())
  eleveId   Int      @map("eleve_id")
  type      String
  details   String   @db.Text
  auteur    String?
  createdAt DateTime @default(now()) @map("created_at")
  eleve     Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@index([eleveId, createdAt])
  @@map("historiques_eleves")
}

model Enseignant {
  id              Int                     @id @default(autoincrement())
  ecoleId         Int                     @map("ecole_id")
  matricule       String
  nom             String
  postnom         String?
  prenom          String
  sexe            String                  @db.VarChar(1)
  dateNaissance   DateTime?               @map("date_naissance") @db.Date
  lieuNaissance   String?                 @map("lieu_naissance")
  nationalite     String?                 @default("Congolaise")
  etatCivil       String?                 @map("etat_civil")
  telephone       String?
  email           String?
  adresse         String?
  photo           String?
  signature       String?
  fonction        String                  @default("Enseignant")
  specialite      String?
  grade           String?
  dateEngagement  DateTime?               @map("date_engagement") @db.Date
  numeroPiece     String?                 @map("numero_piece")
  typePiece       String?                 @map("type_piece")
  numeroCarteRfid String?                 @unique @map("numero_carte_rfid")
  statut          String                  @default("actif")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  ecole           Ecole                   @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  diplomes        DiplomeEnseignant[]
  contrats        ContratEnseignant[]
  affectations    AffectationEnseignant[]
  documents       DocumentEnseignant[]
  historiques     HistoriqueEnseignant[]

  @@unique([ecoleId, matricule])
  @@index([ecoleId, statut])
  @@index([nom, prenom])
  @@map("enseignants")
}

model DiplomeEnseignant {
  id            Int        @id @default(autoincrement())
  enseignantId  Int        @map("enseignant_id")
  intitule      String
  etablissement String?
  annee         Int?
  fichier       String?
  createdAt     DateTime   @default(now()) @map("created_at")
  enseignant    Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  @@index([enseignantId])
  @@map("diplomes_enseignants")
}

model ContratEnseignant {
  id           Int        @id @default(autoincrement())
  enseignantId Int        @map("enseignant_id")
  typeContrat  String     @map("type_contrat")
  dateDebut    DateTime   @map("date_debut") @db.Date
  dateFin      DateTime?  @map("date_fin") @db.Date
  salaire      Decimal?   @db.Decimal(14, 2)
  devise       String     @default("CDF")
  statut       String     @default("actif")
  createdAt    DateTime   @default(now()) @map("created_at")
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  @@index([enseignantId, statut])
  @@map("contrats_enseignants")
}

model AffectationEnseignant {
  id            Int        @id @default(autoincrement())
  enseignantId  Int        @map("enseignant_id")
  classeId      Int?       @map("classe_id")
  matiere       String
  volumeHoraire Int?       @map("volume_horaire")
  anneeLibelle  String?    @map("annee_libelle")
  statut        String     @default("active")
  createdAt     DateTime   @default(now()) @map("created_at")
  enseignant    Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  classe        Classe?    @relation(fields: [classeId], references: [id], onDelete: SetNull)

  @@index([enseignantId])
  @@index([classeId])
  @@map("affectations_enseignants")
}

model DocumentEnseignant {
  id           Int        @id @default(autoincrement())
  enseignantId Int        @map("enseignant_id")
  type         String
  nomFichier   String     @map("nom_fichier")
  chemin       String
  createdAt    DateTime   @default(now()) @map("created_at")
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  @@index([enseignantId])
  @@map("documents_enseignants")
}

model HistoriqueEnseignant {
  id           Int        @id @default(autoincrement())
  enseignantId Int        @map("enseignant_id")
  type         String
  details      String     @db.Text
  auteur       String?
  createdAt    DateTime   @default(now()) @map("created_at")
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  @@index([enseignantId, createdAt])
  @@map("historiques_enseignants")
}

// =========================================================
// DS SCHOOL ENTERPRISE — SAFE CAMPUS CORE V1
// RFID / NFC — CARTES, LECTEURS ET PASSAGES
// =========================================================

enum TypeProprietaireRfid {
  ELEVE
  ENSEIGNANT
  PERSONNEL
  VISITEUR
}

enum StatutCarteRfid {
  ACTIVE
  SUSPENDUE
  PERDUE
  EXPIREE
  ARCHIVEE
}

enum TypeLecteurRfid {
  USB_HID
  NFC
  RESEAU
  ZKTECO
  HID
  ACS
  AUTRE
}

enum StatutLecteurRfid {
  ACTIF
  INACTIF
  MAINTENANCE
}

enum DirectionPassage {
  ENTREE
  SORTIE
}

enum ResultatPassage {
  AUTORISE
  REFUSE
  CARTE_INCONNUE
  CARTE_INACTIVE
}

model CarteRfid {
  id                  Int                   @id @default(autoincrement())
  uid                 String                @unique @db.VarChar(191)
  numeroInterne       String?               @unique @map("numero_interne") @db.VarChar(100)
  typeProprietaire    TypeProprietaireRfid  @map("type_proprietaire")
  proprietaireId      Int                   @map("proprietaire_id")
  nomProprietaire     String                @map("nom_proprietaire") @db.VarChar(191)
  photoProprietaire   String?               @map("photo_proprietaire") @db.VarChar(500)
  classeOuFonction    String?               @map("classe_ou_fonction") @db.VarChar(191)
  statut              StatutCarteRfid       @default(ACTIVE)
  dateActivation      DateTime              @default(now()) @map("date_activation")
  dateExpiration      DateTime?             @map("date_expiration")
  motifDesactivation String?                @map("motif_desactivation") @db.Text
  creeLe              DateTime              @default(now()) @map("cree_le")
  modifieLe           DateTime              @updatedAt @map("modifie_le")
  passages            PassageRfid[]

  @@index([typeProprietaire, proprietaireId])
  @@index([statut])
  @@map("cartes_rfid")
}

model LecteurRfid {
  id               Int                @id @default(autoincrement())
  code             String             @unique @db.VarChar(80)
  nom              String             @db.VarChar(191)
  type             TypeLecteurRfid    @default(USB_HID)
  emplacement      String             @db.VarChar(191)
  adresseIp        String?            @map("adresse_ip") @db.VarChar(100)
  port             Int?
  cleApi           String?            @map("cle_api") @db.VarChar(191)
  directionDefaut  DirectionPassage?  @map("direction_defaut")
  statut           StatutLecteurRfid  @default(ACTIF)
  derniereActivite DateTime?          @map("derniere_activite")
  creeLe           DateTime           @default(now()) @map("cree_le")
  modifieLe        DateTime           @updatedAt @map("modifie_le")
  passages         PassageRfid[]

  @@index([statut])
  @@map("lecteurs_rfid")
}

model PassageRfid {
  id                Int                    @id @default(autoincrement())
  carteId           Int?                   @map("carte_id")
  lecteurId         Int?                   @map("lecteur_id")
  uidLu             String                 @map("uid_lu") @db.VarChar(191)
  typeProprietaire  TypeProprietaireRfid?  @map("type_proprietaire")
  proprietaireId    Int?                   @map("proprietaire_id")
  nomProprietaire   String?                @map("nom_proprietaire") @db.VarChar(191)
  photoProprietaire String?                @map("photo_proprietaire") @db.VarChar(500)
  classeOuFonction  String?                @map("classe_ou_fonction") @db.VarChar(191)
  direction         DirectionPassage
  resultat          ResultatPassage
  message           String?                @db.VarChar(500)
  dateHeure         DateTime               @default(now()) @map("date_heure")
  adresseIpSource   String?                @map("adresse_ip_source") @db.VarChar(100)
  carte             CarteRfid?             @relation(fields: [carteId], references: [id], onDelete: SetNull)
  lecteur           LecteurRfid?           @relation(fields: [lecteurId], references: [id], onDelete: SetNull)

  @@index([dateHeure])
  @@index([proprietaireId, typeProprietaire])
  @@index([resultat])
  @@index([carteId])
  @@index([lecteurId])
  @@map("passages_rfid")
}

